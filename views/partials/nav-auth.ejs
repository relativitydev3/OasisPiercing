<nav class="auth-nav<%= typeof navVariant !== 'undefined' && navVariant === 'account' ? ' auth-nav--account' : '' %>">
  <a href="/" class="auth-nav-logo">
    <img src="/images/logo-sin-fondo.png" alt="Oasis Piercing" width="160" height="48">
  </a>
  <div class="auth-nav-links">
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/mis-pedidos" class="<%= typeof activeNav !== 'undefined' && activeNav === 'pedidos' ? 'is-active' : '' %><%= typeof navVariant !== 'undefined' && navVariant === 'account' ? ' auth-nav-pill' : '' %>">Mis pedidos</a>
      <% if (user.rol_id === 2) { %>
        <a href="/admin/productos">Panel admin</a>
      <% } %>
      <span class="auth-nav-user"><%= user.nombre %></span>
      <form action="/logout" method="POST" class="auth-inline-form">
        <%- include('./csrf-field') %>
        <button type="submit" class="auth-link-btn">Salir</button>
      </form>
    <% } else { %>
      <a href="/login">Iniciar sesión</a>
      <a href="/registro" class="auth-btn-sm">Registrarse</a>
    <% } %>
  </div>
</nav>
