<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title : 'Error' %> — Oasis Piercing</title>
  <link rel="icon" href="/images/logo-sin-fondo.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Instrument+Serif&display=swap" rel="stylesheet">
  <style>
    :root {
      --ep-ink-0: #050507;
      --ep-ink-1: #0c0c10;
      --ep-ink-2: #14141c;
      --ep-text: #f4f4f6;
      --ep-text-md: #b8b8c4;
      --ep-text-dim: #7a7a88;
      --ep-gold: #d4a853;
      --ep-gold-lt: #e8c878;
      --ep-border: rgba(255, 255, 255, 0.08);
      --ep-red: #ff8a8a;
      --ep-font: 'Plus Jakarta Sans', system-ui, sans-serif;
      --ep-serif: 'Instrument Serif', Georgia, serif;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: var(--ep-font);
      font-size: 16px;
      line-height: 1.5;
      color: var(--ep-text);
      background: var(--ep-ink-0);
      background-image:
        radial-gradient(ellipse 120% 80% at 50% -30%, rgba(212, 168, 83, 0.12), transparent 55%),
        radial-gradient(ellipse 60% 50% at 100% 50%, rgba(155, 127, 255, 0.06), transparent 50%);
    }
    .ep-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 16px 24px;
      border-bottom: 1px solid var(--ep-border);
      background: rgba(12, 12, 16, 0.85);
      backdrop-filter: blur(12px);
    }
    .ep-nav-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--ep-gold-lt);
      font-weight: 700;
      font-size: 1.05rem;
      letter-spacing: 0.02em;
    }
    .ep-nav-brand img {
      height: 40px;
      width: auto;
      display: block;
    }
    .ep-nav-brand span { display: none; }
    .ep-nav-brand img[src=""], .ep-nav-brand:not(:has(img)) span { display: inline; }
    .ep-nav-links { display: flex; gap: 12px; flex-wrap: wrap; }
    .ep-nav-links a {
      color: var(--ep-text-md);
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 999px;
      border: 1px solid var(--ep-border);
      transition: color 0.2s, border-color 0.2s;
    }
    .ep-nav-links a:hover { color: var(--ep-gold-lt); border-color: rgba(212, 168, 83, 0.35); }
    .ep-nav-links a.ep-nav-cta {
      border: none;
      background: linear-gradient(135deg, #b8892e, var(--ep-gold));
      color: var(--ep-ink-0);
    }
    .ep-main {
      max-width: 560px;
      margin: 0 auto;
      padding: 40px 20px 64px;
    }
    .ep-card {
      padding: 32px 28px 28px;
      border-radius: 20px;
      border: 1px solid rgba(212, 168, 83, 0.2);
      background: linear-gradient(160deg, rgba(22, 22, 30, 0.98) 0%, rgba(10, 10, 14, 0.98) 100%);
      box-shadow: 0 28px 64px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .ep-badge-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .ep-status {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 56px;
      padding: 6px 16px;
      border-radius: 999px;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.06em;
      border: 1px solid rgba(255, 130, 130, 0.4);
      background: rgba(255, 70, 70, 0.12);
      color: var(--ep-red);
    }
    .ep-status--warn {
      border-color: rgba(212, 168, 83, 0.45);
      background: rgba(212, 168, 83, 0.12);
      color: var(--ep-gold-lt);
    }
    .ep-eyebrow-inline {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ep-gold);
    }
    .ep-title {
      margin: 0 0 12px;
      font-family: var(--ep-serif);
      font-size: clamp(1.65rem, 5vw, 2.1rem);
      font-weight: 400;
      line-height: 1.2;
      color: var(--ep-text);
    }
    .ep-lead {
      margin: 0 0 22px;
      font-size: 0.98rem;
      line-height: 1.6;
      color: var(--ep-text-md);
    }
    .ep-exact {
      margin: 0 0 20px;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid rgba(255, 120, 120, 0.28);
      background: rgba(0, 0, 0, 0.4);
    }
    .ep-exact-label {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ep-text-dim);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .ep-exact-label::before {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #ff6b6b;
      box-shadow: 0 0 10px rgba(255, 100, 100, 0.6);
    }
    .ep-exact pre {
      margin: 0;
      padding: 16px 14px;
      max-height: 200px;
      overflow: auto;
      font-family: ui-monospace, Consolas, monospace;
      font-size: 13px;
      line-height: 1.55;
      color: #ffc9c9;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .ep-hint {
      margin: 0 0 18px;
      padding: 14px 16px;
      border-radius: 12px;
      border-left: 3px solid var(--ep-gold);
      background: rgba(212, 168, 83, 0.08);
      font-size: 14px;
      line-height: 1.55;
      color: var(--ep-text-md);
    }
    .ep-hint strong {
      display: block;
      margin-bottom: 6px;
      color: var(--ep-text);
      font-size: 13px;
    }
    .ep-meta {
      display: grid;
      gap: 10px;
      margin-bottom: 16px;
    }
    .ep-meta-item {
      padding: 12px 14px;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--ep-border);
    }
    .ep-meta dt {
      margin: 0 0 4px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ep-text-dim);
    }
    .ep-meta dd {
      margin: 0;
      font-size: 13px;
      color: var(--ep-text-md);
      word-break: break-word;
    }
    .ep-meta code {
      font-family: ui-monospace, monospace;
      font-size: 12px;
      padding: 3px 8px;
      border-radius: 6px;
      background: var(--ep-ink-0);
      color: var(--ep-gold-lt);
    }
    .ep-context {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 14px;
      margin-bottom: 18px;
      font-size: 12px;
      color: var(--ep-text-dim);
    }
    .ep-context code {
      padding: 2px 8px;
      border-radius: 6px;
      background: var(--ep-ink-1);
      color: var(--ep-text-md);
      font-size: 11px;
    }
    .ep-details {
      margin: 10px 0;
      font-size: 13px;
    }
    .ep-details summary {
      cursor: pointer;
      padding: 10px 0;
      color: var(--ep-gold);
      font-weight: 600;
      list-style: none;
    }
    .ep-details summary::-webkit-details-marker { display: none; }
    .ep-details pre {
      margin: 0 0 8px;
      padding: 14px;
      max-height: 240px;
      overflow: auto;
      border-radius: 10px;
      background: var(--ep-ink-0);
      border: 1px solid var(--ep-border);
      font-size: 11px;
      line-height: 1.45;
      color: #a8a8b8;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .ep-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 26px;
      padding-top: 22px;
      border-top: 1px solid var(--ep-border);
    }
    .ep-btn {
      flex: 1;
      min-width: 130px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 12px 20px;
      border-radius: 12px;
      font-family: inherit;
      font-size: 15px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .ep-btn:active { transform: scale(0.98); }
    .ep-btn-primary {
      background: linear-gradient(135deg, #b8892e, var(--ep-gold));
      color: var(--ep-ink-0);
      box-shadow: 0 8px 24px rgba(212, 168, 83, 0.25);
    }
    .ep-btn-secondary {
      background: transparent;
      color: var(--ep-text-md);
      border: 1px solid var(--ep-border);
    }
    .ep-footer {
      text-align: center;
      padding: 28px 20px 40px;
      font-size: 12px;
      color: var(--ep-text-dim);
    }
    @media (max-width: 480px) {
      .ep-nav { padding: 14px 16px; }
      .ep-card { padding: 24px 18px 22px; }
      .ep-actions { flex-direction: column; }
      .ep-btn { width: 100%; }
    }
  </style>
</head>
<body>
  <header class="ep-nav">
    <a class="ep-nav-brand" href="/">
      <img src="/images/logo-sin-fondo.png" alt="" width="160" height="48" data-img-fallback="logo">
      <span>Oasis Piercing</span>
    </a>
    <nav class="ep-nav-links" aria-label="Cuenta">
      <% if (typeof user !== 'undefined' && user) { %>
        <% if (user.rol_id === 2) { %><a href="/admin/productos">Admin</a><% } %>
        <form action="/logout" method="POST" style="display:inline;margin:0">
          <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <button type="submit" class="ep-btn ep-btn-secondary" style="min-height:36px;padding:8px 14px;font-size:13px">Salir</button>
        </form>
      <% } else { %>
        <a href="/login">Iniciar sesión</a>
        <a href="/registro" class="ep-nav-cta">Registrarse</a>
      <% } %>
    </nav>
  </header>

  <main class="ep-main">
    <article class="ep-card">
      <div class="ep-badge-row">
        <% if (typeof status !== 'undefined' && status) { %>
          <span class="ep-status<%= typeof statusTone === 'warn' ? ' ep-status--warn' : '' %>"><%= status %></span>
        <% } %>
        <% if (typeof eyebrow !== 'undefined' && eyebrow) { %>
          <span class="ep-eyebrow-inline"><%= eyebrow %></span>
        <% } %>
      </div>

      <h1 class="ep-title"><%= heading %></h1>

      <% if (typeof lead !== 'undefined' && lead) { %>
        <p class="ep-lead"><%= lead %></p>
      <% } %>

      <% if (typeof exactError !== 'undefined' && exactError) { %>
        <div class="ep-exact" role="alert">
          <div class="ep-exact-label">Mensaje exacto del error</div>
          <pre><%= exactError %></pre>
        </div>
      <% } %>

      <% if ((typeof errorName !== 'undefined' && errorName) || (typeof requestPath !== 'undefined' && requestPath)) { %>
        <div class="ep-context">
          <% if (typeof errorName !== 'undefined' && errorName) { %>
            <span>Tipo <code><%= errorName %></code></span>
          <% } %>
          <% if (typeof requestPath !== 'undefined' && requestPath) { %>
            <span>Ruta <code><%= requestPath %></code></span>
          <% } %>
        </div>
      <% } %>

      <% if (typeof hint !== 'undefined' && hint) { %>
        <div class="ep-hint" role="status">
          <strong>Qué puedes hacer</strong>
          <%= hint %>
        </div>
      <% } %>

      <% if ((typeof code !== 'undefined' && code) || (typeof detail !== 'undefined' && detail)) { %>
        <dl class="ep-meta">
          <% if (typeof code !== 'undefined' && code) { %>
            <div class="ep-meta-item">
              <dt>Código</dt>
              <dd><code><%= code %></code></dd>
            </div>
          <% } %>
          <% if (typeof detail !== 'undefined' && detail) { %>
            <div class="ep-meta-item">
              <dt>Detalle</dt>
              <dd><%= detail %></dd>
            </div>
          <% } %>
        </dl>
      <% } %>

      <% if (typeof stack !== 'undefined' && stack) { %>
        <details class="ep-details">
          <summary>▸ Traza del error (desarrollo)</summary>
          <pre><%= stack %></pre>
        </details>
      <% } %>

      <div class="ep-actions">
        <a href="/" class="ep-btn ep-btn-primary">Volver al inicio</a>
        <button type="button" class="ep-btn ep-btn-secondary" data-action="reload">Reintentar</button>
      </div>
    </article>
  </main>

  <footer class="ep-footer">
    <p>© <%= new Date().getFullYear() %> Oasis Piercing</p>
  </footer>
  <%- include('script-src', { src: '/js/csp-safe.js', defer: true }) %>
</body>
</html>
