    <section class="test-section" aria-labelledby="test-title">
      <div class="container text-center">
        <span class="s-eyebrow">Testimonios</span>
        <h2 class="s-title" id="test-title">Lo que dicen<br><em>nuestros clientes</em></h2>
      </div>
      <div class="test-track-wrap">
        <div class="test-track" role="list">
          <!-- Cards originales -->
          <article class="test-card" role="listitem">
