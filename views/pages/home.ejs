        <button type="button" class="cart-clear-btn" id="cartClearBtn">Vaciar carrito</button>
      </div>
    </aside>
  </div>
  <div class="cart-toast" id="cartToast" role="status" aria-live="polite"></div>

  <main id="main-content">

    <section class="hero" id="inicio" aria-label="Inicio">
