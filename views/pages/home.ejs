        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
        <div class="hero-grid"></div>
      </div>

      <div class="hero-gems" aria-hidden="true">
        <span class="gem">💎</span>
        <span class="gem">✨</span>
        <span class="gem">💫</span>
        <span class="gem">🌟</span>
        <span class="gem">⭐</span>
        <span class="gem">🔮</span>
      </div>

      <div class="hero-inner">
        <div class="hero-eyebrow" id="heroEyebrow">
          <div class="hero-eyebrow-dot"></div>
          Nueva Colección 2025
        </div>
        <h1 class="hero-h1" id="heroH1">
          Joyería corporal<br>que <span class="line-italic">te define.</span>
        </h1>
        <p class="hero-sub" id="heroSub">Piercings implant-grade en Titanio G23 y Acero 316L. +160 diseños, envío gratis
          desde $80.000 COP y asesoría personalizada por WhatsApp en toda Colombia.</p>
        <div class="hero-actions" id="heroActions">
          <a href="#productos" class="btn-primary btn-magnetic">
            <svg width="17" height="17" aria-hidden="true"><use href="#icon-cart"/></svg>
            <span>Ver catálogo</span>
          </a>
          <a href="https://wa.me/573156819093?text=Hola! Quiero ver los piercings disponibles 💎"
            class="btn-wa btn-magnetic" target="_blank" rel="noopener" aria-label="Hablar por WhatsApp">
            <svg width="17" height="17" aria-hidden="true"><use href="#icon-wa"/></svg>
            Asesoría gratis
          </a>
        </div>
        <div class="hero-trust" id="heroTrust">
          <div class="trust-item">
            <div class="trust-icon">✓</div>Titanio G23 implant-grade
          </div>
          <div class="trust-item">
            <div class="trust-icon">✓</div>Envío gratis desde $80.000 COP
          </div>
          <div class="trust-item">
            <div class="trust-icon">✓</div>Garantía 30 días
          </div>
        </div>
      </div>

      <div class="scroll-hint" aria-hidden="true">
        <div class="scroll-hint-line"></div>
        <span>Scroll</span>
      </div>
    </section>

    <div class="marquee-strip" aria-hidden="true">
      <div class="marquee-track">
        <div class="marquee-item gold">
          <div class="marquee-dot"></div>Titanio G23
        </div>
        <div class="marquee-item">Acero 316L</div>
        <div class="marquee-item gold">
          <div class="marquee-dot"></div>Sin alérgenos
        </div>
        <div class="marquee-item gold">
          <div class="marquee-dot"></div>Envío gratis +$80k
        </div>
        <div class="marquee-item">Envíos Colombia</div>
        <div class="marquee-item gold">
          <div class="marquee-dot"></div>+400 Diseños
        </div>
        <div class="marquee-item">Garantía 30 días</div>
        <div class="marquee-item gold">
          <div class="marquee-dot"></div>Oro PVD 18k
        </div>
        <div class="marquee-item">Asesoría gratis</div>
        <div class="marquee-item gold">
          <div class="marquee-dot"></div>Titanio G23
        </div>
        <div class="marquee-item">Acero 316L</div>
        <div class="marquee-item gold">
          <div class="marquee-dot"></div>Sin alérgenos
        </div>
        <div class="marquee-item gold">
          <div class="marquee-dot"></div>Envío gratis +$80k
        </div>
        <div class="marquee-item">Envíos Colombia</div>
        <div class="marquee-item gold">
          <div class="marquee-dot"></div>+400 Diseños
        </div>
        <div class="marquee-item">Garantía 30 días</div>
        <div class="marquee-item gold">
          <div class="marquee-dot"></div>Oro PVD 18k
        </div>
        <div class="marquee-item">Asesoría gratis</div>
      </div>
    </div>

    <div class="shipping-strip" role="note" aria-label="Envío gratis en Colombia">
      <span class="shipping-strip-icon" aria-hidden="true">🚚</span>
      <span><strong>Envío gratis en Colombia</strong> en compras desde <strong>$80.000 COP</strong></span>
    </div>

    <section class="cat-section" id="categorias" aria-labelledby="cat-title">
      <% if (catalogError) { %>
      <div class="catalog-error" role="alert">
        No se pudo cargar el catálogo: <%= catalogError %>
      </div>
      <% } %>
      <div class="container text-center">
        <span class="s-eyebrow">Colecciones</span>
        <h2 class="s-title" id="cat-title">Encuentra tu<br><em>estilo perfecto</em></h2>
        <p class="s-sub" id="catSubtitle">Explora nuestras colecciones de piercings.</p>
      </div>
      <div class="cat-grid" id="catGrid"></div>
      <p class="cat-empty" id="catEmpty" hidden>No hay categorías disponibles por ahora.</p>
    </section>

    <section class="prod-section" id="productos" aria-labelledby="prod-title">
      <div class="container text-center">
        <span class="s-eyebrow">Catálogo</span>
        <h2 class="s-title" id="prod-title">Los favoritos de<br><em>nuestros clientes</em></h2>
        <p class="s-sub">Filtra por categoría y encuentra el piercing ideal para ti.</p>
      </div>
      <div class="prod-filters-wrap">
        <div class="prod-filters" id="prodFilters" role="tablist" aria-label="Filtrar por categoría"></div>
        <p class="prod-filter-count" id="prodFilterCount" aria-live="polite"></p>
      </div>
      <div class="prod-grid" id="prodGrid"<% if (catalog.products.length) { %> data-ssr="true"<% } %>>
        <% catalog.products.forEach(function (p, i) {
          const mainImg = p.images && p.images[0];
          const catSlugs = (p.categories || []).join(' ');
          const delay = (i % 4) * 0.1;
          const waHref = waLink(buildProductWhatsAppMessage(p));
        %>
        <article
          class="prod-card"
          data-sku="<%= p.sku %>"
          data-category="<%= p.category %>"
          data-categories="<%= catSlugs %>"
          data-delay="<%= delay %>"
          tabindex="0"
          role="button"
          aria-label="Ver detalles de <%= p.name %>"
        >
          <div class="prod-img">
            <span class="prod-badge"><%= p.badge %></span>
            <% if (mainImg && safeImageSrc(mainImg.src)) { %>
              <img
                src="<%= safeImageSrc(mainImg.src) %>"
                alt="<%= mainImg.alt || p.name %>"
                loading="lazy"
                data-fallback="<%= p.emoji %>"
                onerror="this.style.display='none';this.nextElementSibling.hidden=false;this.parentElement.classList.add('has-fallback')"
              >
              <span class="prod-img-fallback" hidden><%= p.emoji %></span>
            <% } else { %>
              <span class="prod-img-fallback"><%= p.emoji %></span>
            <% } %>
            <span class="prod-card-hint">Ver detalles</span>
          </div>
          <div class="prod-body">
            <div class="prod-sku"># <%= p.sku %></div>
            <div class="prod-cat"><%= p.categoryLabel %> · <%= p.type %></div>
            <div class="prod-name"><%= p.name %></div>
            <div class="prod-mat"><%= p.material %></div>
            <p class="prod-desc"><%= p.description %></p>
            <div class="prod-price"><%- formatPriceBlock(p.price, p.oldPrice) %></div>
            <div class="prod-actions">
              <button type="button" class="prod-btn prod-btn-cart" data-action="cart">+ Carrito</button>
              <a href="<%= waHref %>" class="prod-btn-wa-sm" data-action="wa" target="_blank" rel="noopener" aria-label="Preguntar por WhatsApp">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#icon-wa"/></svg> WA
              </a>
            </div>
          </div>
        </article>
        <% }); %>
      </div>
      <p class="prod-empty" id="prodEmpty" hidden>No hay productos en esta categoría por ahora.</p>
      <nav class="prod-pagination" id="prodPagination" aria-label="Paginación de productos" hidden></nav>
    </section>

    <section class="bento-section" aria-labelledby="bento-title">
      <div class="bento-header container">
        <span class="s-eyebrow">Por qué elegirnos</span>
        <h2 class="s-title" id="bento-title">Todo lo que necesitas<br><em>en un solo lugar</em></h2>
      </div>
      <div class="bento-grid container">
        <div class="bento-card bento-large bc-8" data-delay="0">
          <div class="bento-icon">🛡️</div>
          <div class="bento-title">Materiales certificados para tu piel</div>
          <div class="bento-text">Trabajamos exclusivamente con materiales implant-grade que cumplen ASTM F136. Cero
            reacciones alérgicas, incluso en piercings recién realizados. Tu bienestar es nuestra obsesión.</div>
          <div class="material-chips">
            <span class="chip chip-gold">Titanio G23</span>
            <span class="chip chip-gold">Acero 316L</span>
            <span class="chip chip-violet">Oro PVD 18k</span>
            <span class="chip chip-green">Hipoalergénico</span>
          </div>
          <div class="bento-glow bg-gold"></div>
        </div>
        <div class="bento-card bc-4" data-delay="0.1">
          <div class="bento-stat" data-target="500" data-suffix="+">0</div>
          <div class="bento-stat-label">Clientes satisfechos</div>
          <div class="bento-glow bg-violet"></div>
        </div>
        <div class="bento-card bc-4" data-delay="0.15">
          <div class="bento-icon bento-icon-violet">💎</div>
          <div class="bento-title">+400 Diseños</div>
          <div class="bento-text">Desde piezas minimalistas hasta joyería corporal de autor.</div>
        </div>
        <div class="bento-card bc-4" data-delay="0.2">
          <div class="bento-icon">🚀</div>
          <div class="bento-title">2–5 días hábiles</div>
          <div class="bento-text">Envío a todo Colombia con número de seguimiento incluido.</div>
        </div>
        <div class="bento-card bc-4" data-delay="0.25">
          <div class="bento-icon bento-icon-violet">💬</div>
          <div class="bento-title">Asesoría real</div>
          <div class="bento-text">Un experto te guía por WhatsApp para el tamaño y estilo exacto.</div>
        </div>
        <div class="bento-card bc-8" data-delay="0.1">
          <div class="bento-icon">⭐</div>
          <div class="bento-title">4.9/5 en satisfacción</div>
          <div class="bento-text">Más de 1.000 pedidos entregados. El 97% de nuestros clientes vuelve a comprar. La
            calidad habla por sí sola.</div>
          <div class="material-chips" style="margin-top:16px">
            <span class="chip chip-gold">★★★★★ Valentina M.</span>
            <span class="chip chip-violet">★★★★★ Santiago P.</span>
            <span class="chip chip-green">★★★★★ Camila R.</span>
          </div>
          <div class="bento-glow bg-gold"></div>
        </div>
      </div>
    </section>

    <section class="problem-section" aria-labelledby="prob-title">
      <div class="problem-grid">
        <div>
          <span class="s-eyebrow">El problema real</span>
          <h2 class="s-title" id="prob-title">Lo que encuentras<br><em>en otros lugares</em></h2>
          <ul class="problem-list" role="list">
            <li class="problem-item" data-delay="0">
              <div class="problem-x" aria-hidden="true">✕</div>
              <div class="problem-text"><strong>Materiales desconocidos</strong> que causan alergias, inflamación y
                cicatrización incorrecta.</div>
            </li>
            <li class="problem-item" data-delay="0.1">
              <div class="problem-x" aria-hidden="true">✕</div>
              <div class="problem-text"><strong>Diseños genéricos</strong> que no reflejan tu estilo ni tu personalidad
                real.</div>
            </li>
            <li class="problem-item" data-delay="0.2">
              <div class="problem-x" aria-hidden="true">✕</div>
              <div class="problem-text"><strong>Tallas incorrectas</strong> por falta de asesoría. Dolor, rechazo del
                piercing y pérdida de dinero.</div>
            </li>
            <li class="problem-item" data-delay="0.3">
              <div class="problem-x" aria-hidden="true">✕</div>
              <div class="problem-text"><strong>Envíos sin garantía</strong> que llegan dañados o nunca llegan.</div>
            </li>
          </ul>
        </div>
        <div class="solution-card" id="solutionCard">
          <span class="s-eyebrow" style="color:var(--violet)">La diferencia Oasis</span>
          <h3 class="s-title" style="font-size:clamp(26px,3.5vw,40px)">Aquí todo es<br><em class="violet">diferente</em>
          </h3>
          <div class="solution-items">
            <div class="sol-item">
              <div class="sol-check" aria-hidden="true">✓</div>
              <div class="sol-text"><strong>Titanio G23 certificado</strong> — el mismo estándar médico. Cero alergias.
              </div>
            </div>
            <div class="sol-item">
              <div class="sol-check" aria-hidden="true">✓</div>
              <div class="sol-text"><strong>Catálogo curado</strong> — piezas seleccionadas por diseñadores de joyería
                corporal.</div>
            </div>
            <div class="sol-item">
              <div class="sol-check" aria-hidden="true">✓</div>
              <div class="sol-text"><strong>Asesoría real por WhatsApp</strong> — enviamos foto y te medimos el gauge
                exacto.</div>
            </div>
            <div class="sol-item">
              <div class="sol-check" aria-hidden="true">✓</div>
              <div class="sol-text"><strong>Garantía de 30 días</strong> — si algo falla, lo resolvemos sin costo.</div>
            </div>
          </div>
        </div>
      </div>
    </section>



