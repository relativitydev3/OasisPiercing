<%- include('../../../partials/admin-page-header', {
  breadcrumbs: [{ label: 'Admin', href: '/admin/dashboard' }, { label: 'Ventas' }],
  pageHeading: 'Ventas',
  pageSubtitle: ventas.length
    ? `${ventas.length} venta${ventas.length === 1 ? '' : 's'} · pedidos entregados`
    : 'Solo cuenta como venta un pedido con estado entregado',
  pageAction: null
}) %>

<%- include('../../../partials/admin-flash') %>

<form class="admin-ventas-filter" method="GET" action="/admin/ventas">
  <div class="admin-ventas-filter-row">
    <label class="admin-dash-ventas-field">
      <span>Desde</span>
      <input type="date" name="desde" value="<%= filters.desde || '' %>">
    </label>
    <label class="admin-dash-ventas-field">
      <span>Hasta</span>
      <input type="date" name="hasta" value="<%= filters.hasta || '' %>">
    </label>
    <button type="submit" class="admin-btn admin-btn-primary admin-btn-sm">Filtrar</button>
    <% if (filters.desde || filters.hasta) { %>
      <a href="/admin/ventas" class="admin-btn admin-btn-ghost admin-btn-sm">Limpiar</a>
    <% } %>
  </div>
  <p class="admin-ventas-filter-hint">La fecha corresponde al momento en que el pedido quedó entregado.</p>
</form>

<% if (ventas.length) { %>
  <div class="admin-stats">
    <div class="admin-stat">
      <p class="admin-stat-value"><%= summary.count %></p>
      <p class="admin-stat-label">Ventas<%= filters.desde || filters.hasta ? ' (filtro)' : '' %></p>
    </div>
    <div class="admin-stat">
      <p class="admin-stat-value">$<%= Math.round(summary.total).toLocaleString('es-CO') %></p>
      <p class="admin-stat-label">Ingresos</p>
    </div>
    <div class="admin-stat">
      <p class="admin-stat-value">$<%= Math.round(summary.promedio).toLocaleString('es-CO') %></p>
      <p class="admin-stat-label">Ticket promedio</p>
    </div>
    <div class="admin-stat">
      <p class="admin-stat-value"><%= summary.unidades %></p>
      <p class="admin-stat-label">Productos vendidos</p>
    </div>
    <% if (!filters.desde && !filters.hasta) { %>
    <div class="admin-stat">
      <p class="admin-stat-value">$<%= Math.round(summary.ingresosMes).toLocaleString('es-CO') %></p>
      <p class="admin-stat-label">Ingresos del mes</p>
    </div>
    <% } %>
  </div>
<% } %>

<div class="admin-table-wrap">
  <div class="admin-table-toolbar">
    <span class="admin-table-count" data-filter-count hidden></span>
    <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-clear-filters hidden>Limpiar filtros</button>
  </div>
  <div class="admin-table-scroll">
    <table class="admin-table admin-table-filterable">
      <thead>
        <tr>
          <th>Pedido</th>
          <th>Cliente</th>
          <th>Productos</th>
          <th>Total</th>
          <th>Fecha venta</th>
          <th class="col-actions">Acciones</th>
        </tr>
        <tr class="admin-table-filters">
          <th><input type="search" class="admin-table-filter" placeholder="Nº pedido..." aria-label="Filtrar pedido"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Cliente..." aria-label="Filtrar cliente"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Cantidad..." aria-label="Filtrar productos"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Total..." aria-label="Filtrar total"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Fecha..." aria-label="Filtrar fecha"></th>
          <th class="col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% if (ventas.length) {
          ventas.forEach((v) => {
            const fechaVenta = new Date(v.updated_at || v.created_at);
            const fechaStr = fechaVenta.toLocaleDateString('es-CO', {
              day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit',
            });
        %>
          <tr>
            <td><a href="/admin/ventas/<%= v.id %>" class="admin-product-code"><%= v.numero_pedido %></a></td>
            <td><span class="admin-product-name"><%= v.cliente_nombre %> <%= v.cliente_apellido %></span></td>
            <td><span class="admin-tag"><%= v.total_items %> producto<%= v.total_items === 1 ? '' : 's' %></span></td>
            <td><span class="admin-price">$<%= Number(v.total).toLocaleString('es-CO') %></span></td>
            <td><%= fechaStr %></td>
            <td class="admin-actions col-actions">
              <a href="/admin/ventas/<%= v.id %>" class="admin-action-btn admin-action-btn-icon" title="Ver venta" aria-label="Ver venta">
                <%- include('../../../partials/admin-action-icon', { icon: 'view' }) %>
              </a>
              <a href="/admin/pedidos/<%= v.id %>/pdf" class="admin-action-btn admin-action-btn-icon" title="PDF" aria-label="Descargar PDF">
                <%- include('../../../partials/admin-action-icon', { icon: 'download' }) %>
              </a>
            </td>
          </tr>
        <% });
        } else { %>
          <tr class="admin-empty-row">
            <td colspan="6">
              <%- include('../../../partials/admin-empty', {
                title: 'Sin ventas registradas',
                description: filters.desde || filters.hasta
                  ? 'No hay pedidos entregados en el rango seleccionado.'
                  : 'Cuando marques un pedido como entregado, aparecerá aquí como venta.',
                action: { href: '/admin/pedidos', label: 'Ir a pedidos' }
              }) %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
