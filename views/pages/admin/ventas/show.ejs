<%
  const fechaVenta = new Date(venta.updated_at || venta.created_at).toLocaleDateString('es-CO', {
    day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit',
  });
  const fechaPedido = new Date(venta.created_at).toLocaleDateString('es-CO', {
    day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit',
  });
  const clienteNombre = `${venta.cliente_nombre} ${venta.cliente_apellido}`.trim();
%>

<%- include('../../../partials/admin-page-header', {
  breadcrumbs: [
    { label: 'Admin', href: '/admin/dashboard' },
    { label: 'Ventas', href: '/admin/ventas' },
    { label: venta.numero_pedido }
  ],
  pageHeading: `Venta ${venta.numero_pedido}`,
  pageSubtitle: '<a href="/admin/ventas">← Volver al listado</a>',
  pageAction: null
}) %>

<%- include('../../../partials/admin-flash') %>

<div class="admin-product-view">
  <div class="admin-product-view-main">
    <article class="admin-form-card admin-product-panel">
      <div class="admin-pedido-meta-bar admin-pedido-meta-bar--show">
        <div class="admin-pedido-meta-item">
          <span class="admin-pedido-meta-label">Estado</span>
          <span class="admin-badge admin-badge-pedido admin-badge-pedido--entregado">Entregado</span>
        </div>
        <div class="admin-pedido-meta-item">
          <span class="admin-pedido-meta-label">Total venta</span>
          <span class="admin-pedido-meta-value admin-price">$<%= Number(venta.total).toLocaleString('es-CO') %></span>
        </div>
        <div class="admin-pedido-meta-item">
          <span class="admin-pedido-meta-label">Fecha venta</span>
          <span class="admin-pedido-meta-value"><%= fechaVenta %></span>
        </div>
      </div>

      <div class="admin-form-card-body">
        <h2 class="admin-product-panel-heading">Cliente</h2>
        <dl class="admin-product-facts admin-product-facts--3">
          <div class="admin-product-fact">
            <dt>Nombre</dt>
            <dd><%= clienteNombre %></dd>
          </div>
          <div class="admin-product-fact admin-product-fact--wide">
            <dt>Dirección</dt>
            <dd><%= venta.cliente_direccion %></dd>
          </div>
        </dl>

        <h2 class="admin-product-panel-heading admin-product-panel-heading--spaced">Productos vendidos</h2>
        <div class="admin-table-wrap">
          <div class="admin-table-scroll">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Producto</th>
                  <th>Código</th>
                  <th>Cant.</th>
                  <th>P. unit.</th>
                  <th>Subtotal</th>
                </tr>
              </thead>
              <tbody>
                <% venta.items.forEach((item) => { %>
                  <tr>
                    <td><span class="admin-product-name"><%= item.producto_nombre %></span></td>
                    <td><span class="admin-product-code"><%= item.producto_codigo %></span></td>
                    <td><%= item.cantidad %></td>
                    <td><span class="admin-price">$<%= Number(item.precio_unitario).toLocaleString('es-CO') %></span></td>
                    <td><span class="admin-price">$<%= Number(item.subtotal).toLocaleString('es-CO') %></span></td>
                  </tr>
                <% }) %>
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="4" class="admin-show-table-total-label">Total de la venta</td>
                  <td><span class="admin-price">$<%= Number(venta.total).toLocaleString('es-CO') %></span></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

        <% if (venta.notas?.trim()) { %>
          <h2 class="admin-product-panel-heading admin-product-panel-heading--spaced">Notas</h2>
          <div class="admin-product-panel-desc"><%= venta.notas %></div>
        <% } %>
      </div>
    </article>
  </div>

  <aside class="admin-product-view-aside">
    <section class="admin-form-card admin-product-aside-card">
      <div class="admin-form-card-head admin-form-card-head--compact">
        <h2 class="admin-form-card-title">Acciones</h2>
      </div>
      <div class="admin-form-card-body admin-product-aside-actions">
        <a href="/admin/pedidos/<%= venta.id %>/pdf" class="admin-btn admin-btn-primary admin-btn-block admin-product-aside-cta" download>
          <%- include('../../../partials/admin-action-icon', { icon: 'download' }) %>
          <span>Descargar PDF</span>
        </a>
      </div>
    </section>

    <section class="admin-form-card admin-product-aside-meta">
      <div class="admin-form-card-body">
        <p class="admin-product-meta-row">
          <span class="admin-product-meta-label">Pedido creado</span>
          <span class="admin-product-meta-value"><%= fechaPedido %></span>
        </p>
        <p class="admin-product-meta-row">
          <span class="admin-product-meta-label">Entregado</span>
          <span class="admin-product-meta-value"><%= fechaVenta %></span>
        </p>
        <p class="admin-product-meta-row">
          <span class="admin-product-meta-label">Nº pedido</span>
          <code class="admin-code"><%= venta.numero_pedido %></code>
        </p>
      </div>
    </section>
  </aside>
</div>
