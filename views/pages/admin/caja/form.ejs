<%
  const formAction = mode === 'create'
    ? '/admin/caja' + (mes ? '?mes=' + encodeURIComponent(mes) : '')
    : '/admin/caja/' + movimiento.id + (mes ? '?mes=' + encodeURIComponent(mes) : '');
  const fechaVal = old.fecha || movimiento?.fecha || defaultFecha;
  const tipoVal = old.tipo || movimiento?.tipo || 'gasto';
%>

<%- include('../../../partials/admin-page-header', {
  breadcrumbs: [
    { label: 'Admin', href: '/admin/dashboard' },
    { label: 'Caja', href: '/admin/caja' + (mes ? '?mes=' + encodeURIComponent(mes) : '') },
    { label: mode === 'create' ? 'Nuevo' : 'Editar' }
  ],
  pageHeading: mode === 'create' ? 'Registrar movimiento' : 'Editar movimiento',
  pageSubtitle: '<a href="/admin/caja' + (mes ? '?mes=' + encodeURIComponent(mes) : '') + '">← Volver a caja</a>',
  pageAction: null
}) %>

<%- include('../../../partials/admin-flash') %>

<form action="<%= formAction %>" method="POST" class="admin-form" novalidate>
  <%- include('../../../partials/csrf-field') %>
  <% if (mes) { %><input type="hidden" name="mes" value="<%= mes %>"><% } %>

  <section class="admin-form-card">
    <div class="admin-form-card-head">
      <span class="admin-form-card-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v4H4zM4 10h16v10H4z"/></svg>
      </span>
      <div class="admin-form-card-meta">
        <h2 class="admin-form-card-title">Movimiento de caja</h2>
        <p class="admin-form-card-desc">Los gastos restan del balance; los ingresos extra lo aumentan.</p>
      </div>
    </div>
    <div class="admin-form-card-body">
      <div class="admin-field<%= errors.tipo ? ' has-error' : '' %>">
        <label class="admin-label">Tipo<span class="admin-required">*</span></label>
        <div class="admin-caja-tipo-grid">
          <% cajaTipos.forEach((t) => { %>
            <label class="admin-caja-tipo-option<%= tipoVal === t.value ? ' is-selected' : '' %>">
              <input type="radio" name="tipo" value="<%= t.value %>" <%= tipoVal === t.value ? 'checked' : '' %> required>
              <span class="admin-caja-tipo-label"><%= t.label %></span>
              <span class="admin-caja-tipo-hint"><%= t.hint %></span>
            </label>
          <% }) %>
        </div>
        <% if (errors.tipo) { %><p class="admin-field-error" role="alert"><%= errors.tipo %></p><% } %>
      </div>

      <div class="admin-grid-2">
        <div class="admin-field<%= errors.monto ? ' has-error' : '' %>">
          <label class="admin-label" for="monto">Monto (COP)<span class="admin-required">*</span></label>
          <input class="admin-input" type="number" id="monto" name="monto" min="1" step="1" required
            value="<%= old.monto ?? movimiento?.monto ?? '' %>" placeholder="Ej. 50000">
          <% if (errors.monto) { %><p class="admin-field-error" role="alert"><%= errors.monto %></p><% } %>
        </div>
        <div class="admin-field<%= errors.fecha ? ' has-error' : '' %>">
          <label class="admin-label" for="fecha">Fecha<span class="admin-required">*</span></label>
          <input class="admin-input" type="date" id="fecha" name="fecha" required value="<%= fechaVal %>">
          <% if (errors.fecha) { %><p class="admin-field-error" role="alert"><%= errors.fecha %></p><% } %>
        </div>
      </div>

      <div class="admin-field<%= errors.concepto ? ' has-error' : '' %>">
        <label class="admin-label" for="concepto">Concepto<span class="admin-required">*</span></label>
        <input class="admin-input" type="text" id="concepto" name="concepto" required maxlength="200"
          value="<%= old.concepto || movimiento?.concepto || '' %>" placeholder="Ej. Compra de insumos, empaques...">
        <% if (errors.concepto) { %><p class="admin-field-error" role="alert"><%= errors.concepto %></p><% } %>
      </div>

      <div class="admin-field<%= errors.notas ? ' has-error' : '' %>">
        <label class="admin-label" for="notas">Notas</label>
        <textarea class="admin-textarea" id="notas" name="notas" rows="3" maxlength="1000" placeholder="Detalle opcional..."><%= old.notas || movimiento?.notas || '' %></textarea>
        <% if (errors.notas) { %><p class="admin-field-error" role="alert"><%= errors.notas %></p><% } %>
      </div>
    </div>
  </section>

  <footer class="admin-form-footer">
    <button type="submit" class="admin-btn admin-btn-primary"><%= mode === 'create' ? 'Registrar' : 'Guardar cambios' %></button>
    <a href="/admin/caja<%= mes ? '?mes=' + encodeURIComponent(mes) : '' %>" class="admin-btn admin-btn-ghost">Cancelar</a>
  </footer>
</form>

<%- include('../../partials/script-src', { src: '/js/admin-caja-form.js', defer: true }) %>
