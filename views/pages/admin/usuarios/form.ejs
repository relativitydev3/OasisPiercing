<%- include('../../../partials/head', { title, bodyClass: 'admin-body' }) %>
<%- include('../../../partials/admin-layout-start') %>

<main class="admin-main">
  <div class="admin-header">
    <div>
      <h1 class="auth-title"><%= mode === 'create' ? 'Nuevo usuario' : 'Editar usuario' %></h1>
      <p class="auth-sub"><a href="/admin/usuarios">← Volver al listado</a></p>
    </div>
  </div>

  <%- include('../../../partials/flash') %>

  <div class="auth-card admin-form-card">
    <form action="<%= mode === 'create' ? '/admin/usuarios' : '/admin/usuarios/' + usuario.id %>" method="POST" class="auth-form" novalidate>
      <%- include('../../../partials/csrf-field') %>
      <div class="auth-grid-2">
        <div class="auth-field">
          <label for="nombre">Nombre *</label>
          <input type="text" id="nombre" name="nombre" value="<%= old.nombre || usuario?.nombre || '' %>" required>
          <% if (errors.nombre) { %><span class="auth-error"><%= errors.nombre %></span><% } %>
        </div>
        <div class="auth-field">
          <label for="apellido">Apellido</label>
          <input type="text" id="apellido" name="apellido" value="<%= old.apellido || usuario?.apellido || '' %>">
          <% if (errors.apellido) { %><span class="auth-error"><%= errors.apellido %></span><% } %>
        </div>
      </div>

      <div class="auth-field">
        <label for="email">Email *</label>
        <input type="email" id="email" name="email" value="<%= old.email || usuario?.email || '' %>" required>
        <% if (errors.email) { %><span class="auth-error"><%= errors.email %></span><% } %>
      </div>

      <div class="auth-field">
        <label for="telefono">Teléfono</label>
        <input type="tel" id="telefono" name="telefono" value="<%= old.telefono || usuario?.telefono || '' %>">
        <% if (errors.telefono) { %><span class="auth-error"><%= errors.telefono %></span><% } %>
      </div>

      <div class="auth-field">
        <label for="rol_id">Rol *</label>
        <select id="rol_id" name="rol_id" required>
          <% roles.forEach((rol) => { %>
            <option value="<%= rol.id %>"
              <%= String(old.rol_id || usuario?.rol_id || '') === String(rol.id) ? 'selected' : '' %>>
              <%= rol.nombre %>
            </option>
          <% }) %>
        </select>
        <% if (errors.rol_id) { %><span class="auth-error"><%= errors.rol_id %></span><% } %>
      </div>

      <div class="auth-grid-2">
        <div class="auth-field">
          <label for="password"><%= mode === 'create' ? 'Contraseña *' : 'Nueva contraseña' %></label>
          <input type="password" id="password" name="password" autocomplete="new-password" <%= mode === 'create' ? 'required' : '' %>>
          <% if (errors.password) { %><span class="auth-error"><%= errors.password %></span><% } %>
        </div>
        <div class="auth-field">
          <label for="confirmar_password">Confirmar contraseña</label>
          <input type="password" id="confirmar_password" name="confirmar_password" autocomplete="new-password">
          <% if (errors.confirmar_password) { %><span class="auth-error"><%= errors.confirmar_password %></span><% } %>
        </div>
      </div>

      <div class="auth-checks">
        <% const activoChecked = (typeof old.activo !== 'undefined')
          ? (old.activo === 'on' || old.activo === true)
          : (usuario ? usuario.activo : true); %>
        <label class="auth-check">
          <input type="checkbox" name="activo" <%= activoChecked ? 'checked' : '' %>>
          Usuario activo
        </label>
        <% if (mode === 'create') { %>
          <label class="auth-check">
            <input type="checkbox" name="email_verificado" <%= old.email_verificado === 'on' ? 'checked' : '' %>>
            Email verificado
          </label>
        <% } %>
      </div>

      <button type="submit" class="auth-btn"><%= mode === 'create' ? 'Crear usuario' : 'Guardar cambios' %></button>
    </form>
  </div>
</main>

<%- include('../../../partials/admin-layout-end') %>
