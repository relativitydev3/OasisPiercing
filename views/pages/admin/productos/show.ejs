<%
  const fechaActualizacion = producto.updated_at
    ? new Date(producto.updated_at).toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' })
    : null;
  const numCategorias = producto.categorias.length;
  const stockBajo = Number(producto.stock) <= 3;
%>

<%- include('../../../partials/admin-page-header', {
  breadcrumbs: [
    { label: 'Admin', href: '/admin/productos' },
    { label: 'Productos', href: '/admin/productos' },
    { label: producto.nombre }
  ],
  pageHeading: producto.nombre,
  pageSubtitle: '<a href="/admin/productos">← Volver al listado</a>',
  pageAction: null
}) %>

<%- include('../../../partials/admin-flash') %>

<div class="admin-product-view">
  <div class="admin-product-view-main">
    <article class="admin-form-card admin-product-panel">
      <div class="admin-product-panel-top">
        <div class="admin-product-panel-media">
          <% if (producto.imagen) { %>
            <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>" width="420" height="420">
          <% } else { %>
            <div class="admin-product-panel-placeholder" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              <span>Sin imagen</span>
            </div>
          <% } %>
        </div>

        <div class="admin-product-panel-summary">
          <div class="admin-product-panel-badges">
            <%- include('../../../partials/admin-status', { activo: producto.activo }) %>
            <span class="admin-tag admin-tag--code" title="<%= producto.codigo %>"><%= producto.codigo %></span>
          </div>

          <div class="admin-product-metrics">
            <div class="admin-product-metric">
              <span class="admin-product-metric-label">Precio</span>
              <span class="admin-product-metric-value admin-product-metric-value--price">$<%= Number(producto.precio).toLocaleString('es-CO') %></span>
            </div>
            <div class="admin-product-metric<%= stockBajo ? ' is-warning' : '' %>">
              <span class="admin-product-metric-label">Stock</span>
              <span class="admin-product-metric-value"><%= producto.stock %></span>
            </div>
            <div class="admin-product-metric">
              <span class="admin-product-metric-label">Categorías</span>
              <span class="admin-product-metric-value"><%= numCategorias %></span>
            </div>
          </div>

          <dl class="admin-product-facts">
            <div class="admin-product-fact">
              <dt>Tipo</dt>
              <dd><%= producto.tipo %></dd>
            </div>
            <div class="admin-product-fact">
              <dt>Material</dt>
              <dd><%= producto.material %></dd>
            </div>
          </dl>

          <% if (numCategorias) { %>
            <div class="admin-product-tags">
              <% producto.categorias.forEach((c) => { %>
                <span class="admin-tag"><%= c.nombre %></span>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

      <div class="admin-product-panel-section">
        <h2 class="admin-product-panel-heading">Descripción</h2>
        <% if (producto.descripcion?.trim()) { %>
          <div class="admin-product-panel-desc"><%= producto.descripcion %></div>
        <% } else { %>
          <p class="admin-field-hint">Sin descripción registrada.</p>
        <% } %>
      </div>
    </article>
  </div>

  <aside class="admin-product-view-aside">
    <section class="admin-form-card admin-product-aside-card">
      <div class="admin-form-card-head admin-form-card-head--compact">
        <h2 class="admin-form-card-title">Acciones</h2>
      </div>
      <div class="admin-form-card-body admin-product-aside-actions">
        <a href="/admin/productos/<%= producto.id %>/editar" class="admin-btn admin-btn-primary admin-btn-block admin-product-aside-cta">
          <%- include('../../../partials/admin-action-icon', { icon: 'edit' }) %>
          <span>Editar producto</span>
        </a>

        <div class="admin-product-aside-list">
          <% if (producto.activo) { %>
            <a href="/?p=<%= encodeURIComponent(producto.codigo) %>#productos" class="admin-product-aside-link" target="_blank" rel="noopener">
              <span class="admin-product-aside-link-icon"><%- include('../../../partials/admin-action-icon', { icon: 'view' }) %></span>
              <span class="admin-product-aside-link-text">Ver en tienda</span>
            </a>
          <% } else { %>
            <span class="admin-product-aside-link is-disabled" aria-disabled="true">
              <span class="admin-product-aside-link-icon"><%- include('../../../partials/admin-action-icon', { icon: 'view' }) %></span>
              <span class="admin-product-aside-link-text">Ver en tienda <small>(requiere activación)</small></span>
            </span>
          <% } %>

          <form action="/admin/productos/<%= producto.id %>/duplicar" method="POST" class="admin-product-aside-form">
            <%- include('../../../partials/csrf-field') %>
            <button type="submit" class="admin-product-aside-link">
              <span class="admin-product-aside-link-icon"><%- include('../../../partials/admin-action-icon', { icon: 'duplicate' }) %></span>
              <span class="admin-product-aside-link-text">Duplicar producto</span>
            </button>
          </form>

          <form action="/admin/productos/<%= producto.id %>/estado" method="POST" class="admin-product-aside-form">
            <%- include('../../../partials/csrf-field') %>
            <input type="hidden" name="activo" value="<%= producto.activo ? 'false' : 'true' %>">
            <button type="submit" class="admin-product-aside-link<%= producto.activo ? '' : ' is-positive' %>">
              <span class="admin-product-aside-link-icon"><%- include('../../../partials/admin-action-icon', { icon: producto.activo ? 'deactivate' : 'activate' }) %></span>
              <span class="admin-product-aside-link-text"><%= producto.activo ? 'Desactivar' : 'Activar' %></span>
            </button>
          </form>
        </div>
      </div>
    </section>

    <section class="admin-form-card admin-product-aside-meta">
      <div class="admin-form-card-body">
        <% if (fechaActualizacion) { %>
          <p class="admin-product-meta-row">
            <span class="admin-product-meta-label">Actualizado</span>
            <span class="admin-product-meta-value"><%= fechaActualizacion %></span>
          </p>
        <% } %>
        <p class="admin-product-meta-row">
          <span class="admin-product-meta-label">Código</span>
          <code class="admin-code" title="<%= producto.codigo %>"><%= producto.codigo %></code>
        </p>
      </div>
    </section>
  </aside>
</div>
