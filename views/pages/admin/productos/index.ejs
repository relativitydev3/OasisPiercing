<%
  const activos = productos.filter((p) => p.activo).length;
  const inactivos = productos.length - activos;
%>

<%- include('../../../partials/admin-page-header', {
  breadcrumbs: [{ label: 'Admin', href: '/admin/productos' }, { label: 'Productos' }],
  pageHeading: 'Productos',
  pageSubtitle: productos.length
    ? `${productos.length} producto${productos.length === 1 ? '' : 's'} en el catálogo`
    : 'Aún no hay productos registrados',
  pageAction: { href: '/admin/productos/nuevo', label: 'Nuevo producto' }
}) %>

<%- include('../../../partials/admin-flash') %>

<% if (productos.length) { %>
  <div class="admin-stats">
    <div class="admin-stat">
      <p class="admin-stat-value"><%= productos.length %></p>
      <p class="admin-stat-label">Total</p>
    </div>
    <div class="admin-stat">
      <p class="admin-stat-value"><%= activos %></p>
      <p class="admin-stat-label">Activos</p>
    </div>
    <div class="admin-stat">
      <p class="admin-stat-value"><%= inactivos %></p>
      <p class="admin-stat-label">Inactivos</p>
    </div>
  </div>
<% } %>

<% if (productos.length) { %>
<div class="admin-table-wrap">
  <div class="admin-table-toolbar">
    <span class="admin-table-count" data-filter-count hidden></span>
    <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-clear-filters hidden>Limpiar filtros</button>
  </div>
  <div class="admin-table-scroll">
    <table class="admin-table admin-table-products admin-table-filterable">
      <thead>
        <tr>
          <th>Producto</th>
          <th>Tipo</th>
          <th>Material</th>
          <th>Precio</th>
          <th>Stock</th>
          <th>Categorías</th>
          <th>Estado</th>
          <th class="col-actions">Acciones</th>
        </tr>
        <tr class="admin-table-filters">
          <th><input type="search" class="admin-table-filter" placeholder="Nombre, código..." aria-label="Filtrar producto"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Tipo..." aria-label="Filtrar tipo"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Material..." aria-label="Filtrar material"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Precio..." aria-label="Filtrar precio"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Stock..." aria-label="Filtrar stock"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Categoría..." aria-label="Filtrar categoría"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Activo..." aria-label="Filtrar estado"></th>
          <th class="col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% productos.forEach((p) => { %>
          <tr>
            <td>
              <div class="admin-cell-product">
                <% if (p.imagen) { %>
                  <img src="<%= p.imagen %>" alt="" class="admin-product-thumb" width="48" height="48">
                <% } else { %>
                  <span class="admin-no-image">—</span>
                <% } %>
                <div>
                  <span class="admin-product-name"><%= p.nombre %></span>
                  <span class="admin-product-code"><%= p.codigo %></span>
                </div>
              </div>
            </td>
            <td><%= p.tipo %></td>
            <td><%= p.material %></td>
            <td><span class="admin-price">$<%= Number(p.precio).toLocaleString('es-CO') %></span></td>
            <td><%= p.stock %></td>
            <td>
              <% if (p.categorias.length) { %>
                <div class="admin-tag-list">
                  <% p.categorias.forEach((c) => { %>
                    <span class="admin-tag"><%= c.nombre %></span>
                  <% }) %>
                </div>
              <% } else { %>
                <span class="admin-tag">Sin categoría</span>
              <% } %>
            </td>
            <td>
              <%- include('../../../partials/admin-status-trigger', {
                activo: p.activo,
                label: p.nombre,
                estadoUrl: '/admin/productos/' + p.id + '/estado'
              }) %>
            </td>
            <td class="admin-actions col-actions">
              <a href="/admin/productos/<%= p.id %>" class="admin-action-btn admin-action-btn-icon" title="Ver producto" aria-label="Ver producto">
                <%- include('../../../partials/admin-action-icon', { icon: 'view' }) %>
              </a>
              <a href="/admin/productos/<%= p.id %>/editar" class="admin-action-btn admin-action-btn-icon" title="Editar" aria-label="Editar">
                <%- include('../../../partials/admin-action-icon', { icon: 'edit' }) %>
              </a>
              <form action="/admin/productos/<%= p.id %>/duplicar" method="POST" class="auth-inline-form">
                <%- include('../../../partials/csrf-field') %>
                <button type="submit" class="admin-action-btn admin-action-btn-icon" title="Duplicar" aria-label="Duplicar">
                  <%- include('../../../partials/admin-action-icon', { icon: 'duplicate' }) %>
                </button>
              </form>
              <form action="/admin/productos/<%= p.id %>/estado" method="POST" class="auth-inline-form">
                <%- include('../../../partials/csrf-field') %>
                <input type="hidden" name="activo" value="<%= p.activo ? 'false' : 'true' %>">
                <button type="submit" class="admin-action-btn admin-action-btn-icon" title="<%= p.activo ? 'Desactivar' : 'Activar' %>" aria-label="<%= p.activo ? 'Desactivar' : 'Activar' %>">
                  <%- include('../../../partials/admin-action-icon', { icon: p.activo ? 'deactivate' : 'activate' }) %>
                </button>
              </form>
              <form action="/admin/productos/<%= p.id %>/eliminar" method="POST" class="auth-inline-form" onsubmit="return confirm('¿Eliminar este producto?');">
                <%- include('../../../partials/csrf-field') %>
                <button type="submit" class="admin-action-btn admin-action-btn-icon admin-action-btn-danger" title="Eliminar" aria-label="Eliminar">
                  <%- include('../../../partials/admin-action-icon', { icon: 'delete' }) %>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } else { %>
<div class="admin-table-wrap">
  <div class="admin-table-scroll">
    <table class="admin-table admin-table-products">
      <thead>
        <tr>
          <th>Producto</th>
          <th>Tipo</th>
          <th>Material</th>
          <th>Precio</th>
          <th>Stock</th>
          <th>Categorías</th>
          <th>Estado</th>
          <th class="col-actions">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <tr class="admin-empty-row">
          <td colspan="8">
            <%- include('../../../partials/admin-empty', {
              title: 'Sin productos',
              description: 'Crea tu primer producto para que aparezca en la tienda.',
              action: { href: '/admin/productos/nuevo', label: 'Crear producto' }
            }) %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
<% } %>

