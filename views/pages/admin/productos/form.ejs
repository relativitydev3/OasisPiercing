<%
  const selectedIds = (() => {
    if (typeof old.categorias !== 'undefined') {
      const raw = old.categorias;
      return (Array.isArray(raw) ? raw : [raw]).map(String).filter(Boolean);
    }
    const ids = producto?.categoria_ids || [];
    return ids.map(String);
  })();
  const activoChecked = (typeof old.activo !== 'undefined')
    ? (old.activo === 'on' || old.activo === true)
    : (producto ? producto.activo : true);
%>

<%- include('../../../partials/admin-page-header', {
  breadcrumbs: [
    { label: 'Admin', href: '/admin/productos' },
    { label: 'Productos', href: '/admin/productos' },
    { label: mode === 'create' ? 'Nuevo' : 'Editar' }
  ],
  pageHeading: mode === 'create' ? 'Nuevo producto' : 'Editar producto',
  pageSubtitle: '<a href="/admin/productos">← Volver al listado</a>',
  pageAction: null
}) %>

<%- include('../../../partials/admin-flash') %>

<form action="<%= mode === 'create' ? '/admin/productos' : '/admin/productos/' + producto.id %>" method="POST" enctype="multipart/form-data" class="admin-form" novalidate>
  <%- include('../../../partials/csrf-field') %>

  <div class="admin-form-columns">
    <div class="admin-form-primary">
      <section class="admin-form-card">
        <div class="admin-form-card-head">
          <span class="admin-form-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
          </span>
          <div class="admin-form-card-meta">
            <h2 class="admin-form-card-title">Información del producto</h2>
            <p class="admin-form-card-desc">Nombre, código y detalles visibles en la tienda.</p>
          </div>
        </div>
        <div class="admin-form-card-body">
          <div class="admin-form-row admin-form-row--2">
            <div class="admin-field<%= errors.nombre ? ' has-error' : '' %>">
              <label class="admin-label" for="nombre">Nombre<span class="admin-required">*</span></label>
              <input class="admin-input" type="text" id="nombre" name="nombre" value="<%= old.nombre || producto?.nombre || '' %>" required placeholder="Labret dorado" autocomplete="off">
              <% if (errors.nombre) { %><p class="admin-field-error" role="alert"><%= errors.nombre %></p><% } %>
            </div>
            <div class="admin-field<%= errors.codigo ? ' has-error' : '' %>">
              <label class="admin-label" for="codigo">Código<span class="admin-required">*</span></label>
              <input class="admin-input" type="text" id="codigo" name="codigo" value="<%= old.codigo || producto?.codigo || '' %>" required placeholder="LAB-001" autocomplete="off">
              <% if (errors.codigo) { %><p class="admin-field-error" role="alert"><%= errors.codigo %></p><% } %>
            </div>
          </div>
          <div class="admin-form-row admin-form-row--2">
            <div class="admin-field<%= errors.tipo ? ' has-error' : '' %>">
              <label class="admin-label" for="tipo">Tipo<span class="admin-required">*</span></label>
              <input class="admin-input" type="text" id="tipo" name="tipo" value="<%= old.tipo || producto?.tipo || '' %>" required placeholder="Labret">
              <% if (errors.tipo) { %><p class="admin-field-error" role="alert"><%= errors.tipo %></p><% } %>
            </div>
            <div class="admin-field<%= errors.material ? ' has-error' : '' %>">
              <label class="admin-label" for="material">Material<span class="admin-required">*</span></label>
              <input class="admin-input" type="text" id="material" name="material" value="<%= old.material || producto?.material || '' %>" required placeholder="Titanio">
              <% if (errors.material) { %><p class="admin-field-error" role="alert"><%= errors.material %></p><% } %>
            </div>
          </div>
          <div class="admin-field<%= errors.descripcion ? ' has-error' : '' %>">
            <label class="admin-label" for="descripcion">Descripción<span class="admin-required">*</span></label>
            <textarea class="admin-textarea" id="descripcion" name="descripcion" rows="5" required placeholder="Material, medidas, acabado..."><%= old.descripcion || producto?.descripcion || '' %></textarea>
            <% if (errors.descripcion) { %><p class="admin-field-error" role="alert"><%= errors.descripcion %></p><% } %>
          </div>
        </div>
      </section>

      <section class="admin-form-card">
        <div class="admin-form-card-head">
          <span class="admin-form-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </span>
          <div class="admin-form-card-meta">
            <h2 class="admin-form-card-title">Precio e inventario</h2>
            <p class="admin-form-card-desc">Valor en COP y unidades disponibles.</p>
          </div>
        </div>
        <div class="admin-form-card-body">
          <div class="admin-form-row admin-form-row--2">
            <div class="admin-field<%= errors.precio ? ' has-error' : '' %>">
              <label class="admin-label" for="precio">Precio<span class="admin-required">*</span></label>
              <div class="admin-input-group">
                <span class="admin-input-prefix">$</span>
                <input class="admin-input" type="number" id="precio" name="precio" min="0.01" step="0.01" value="<%= old.precio ?? producto?.precio ?? '' %>" required placeholder="45000" inputmode="decimal">
              </div>
              <p class="admin-field-hint">Pesos colombianos (COP).</p>
              <% if (errors.precio) { %><p class="admin-field-error" role="alert"><%= errors.precio %></p><% } %>
            </div>
            <div class="admin-field<%= errors.stock ? ' has-error' : '' %>">
              <label class="admin-label" for="stock">Stock<span class="admin-required">*</span></label>
              <input class="admin-input" type="number" id="stock" name="stock" min="0" step="1" value="<%= old.stock ?? producto?.stock ?? '' %>" required placeholder="0" inputmode="numeric">
              <% if (errors.stock) { %><p class="admin-field-error" role="alert"><%= errors.stock %></p><% } %>
            </div>
          </div>
        </div>
      </section>
    </div>

    <aside class="admin-form-secondary">
      <section class="admin-form-card">
        <div class="admin-form-card-head">
          <span class="admin-form-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
          </span>
          <div class="admin-form-card-meta">
            <h2 class="admin-form-card-title">Imagen<% if (mode === 'create') { %><span class="admin-required">*</span><% } %></h2>
            <p class="admin-form-card-desc">Foto principal del catálogo.</p>
          </div>
        </div>
        <div class="admin-form-card-body">
          <% if (mode === 'edit' && producto?.imagen) { %>
            <div class="admin-current-image">
              <img src="<%= producto.imagen %>" alt="" width="72" height="72">
              <span>Imagen actual. Puedes ajustarla o subir otra para reemplazarla.</span>
            </div>
          <% } %>
          <div class="admin-field<%= errors.imagen ? ' has-error' : '' %>">
            <div class="admin-file-zone" data-file-editor="producto"<% if (mode === 'edit' && producto?.imagen) { %> data-existing-image="<%= producto.imagen %>"<% } %>>
              <input class="admin-file-input" type="file" id="imagen" name="imagen" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" <%= mode === 'create' ? 'required' : '' %>>
              <div class="admin-file-ui">
                <div class="admin-file-placeholder">
                  <span class="admin-file-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 16V4m0 0 4 4m-4-4-4 4M4 18v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
                  </span>
                  <p class="admin-file-text">Arrastra o <strong>selecciona</strong></p>
                  <p class="admin-file-meta">Se optimiza a 1200×800 px para el catálogo</p>
                </div>
                <div class="admin-file-preview-frame" aria-hidden="true">
                  <img class="admin-file-preview" alt="Vista previa optimizada">
                </div>
              </div>
              <p class="admin-file-name" aria-live="polite"></p>
            </div>

            <div class="admin-image-actions" id="producto-image-actions" hidden>
              <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" id="producto-image-edit-btn">Ajustar imagen</button>
              <span class="admin-image-meta" id="producto-image-meta"></span>
            </div>

            <% if (errors.imagen) { %><p class="admin-field-error" role="alert"><%= errors.imagen %></p><% } %>
          </div>
        </div>
      </section>

      <section class="admin-form-card">
        <div class="admin-form-card-head">
          <span class="admin-form-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 16h7v4h-7z"/></svg>
          </span>
          <div class="admin-form-card-meta">
            <h2 class="admin-form-card-title">Clasificación</h2>
            <p class="admin-form-card-desc">Categorías y visibilidad pública.</p>
          </div>
        </div>
        <div class="admin-form-card-body">
          <div class="admin-field<%= errors.categorias ? ' has-error' : '' %>">
            <span class="admin-label" id="categorias-label">Categorías<span class="admin-required">*</span></span>
            <% if (!categorias.length) { %>
              <p class="admin-field-hint">No hay categorías. <a href="/admin/categorias/nuevo">Crea una</a> primero.</p>
            <% } else { %>
              <div class="admin-category-options" role="group" aria-labelledby="categorias-label">
                <% categorias.forEach((cat) => { %>
                  <label class="admin-category-option">
                    <input
                      type="checkbox"
                      name="categorias"
                      value="<%= cat.id %>"
                      <%= selectedIds.includes(String(cat.id)) ? 'checked' : '' %>
                    >
                    <span class="admin-category-option-label"><%= cat.nombre %></span>
                  </label>
                <% }) %>
              </div>
              <p class="admin-field-hint">Puedes seleccionar una o varias categorías.</p>
            <% } %>
            <% if (errors.categorias) { %><p class="admin-field-error" role="alert"><%= errors.categorias %></p><% } %>
          </div>

          <label class="admin-toggle">
            <span class="admin-toggle-text">
              <span class="admin-toggle-label">Visible en tienda</span>
              <span class="admin-toggle-desc">Aparece en el catálogo público.</span>
            </span>
            <input type="checkbox" name="activo" <%= activoChecked ? 'checked' : '' %>>
            <span class="admin-toggle-switch" aria-hidden="true"></span>
          </label>
        </div>
      </section>
    </aside>
  </div>

  <footer class="admin-form-footer">
    <button type="submit" class="admin-btn admin-btn-primary"><%= mode === 'create' ? 'Crear producto' : 'Guardar cambios' %></button>
    <a href="/admin/productos" class="admin-btn admin-btn-ghost">Cancelar</a>
  </footer>
</form>

<div class="admin-image-modal" id="producto-image-modal" hidden aria-hidden="true">
  <div class="admin-image-modal-overlay" id="producto-image-modal-overlay"></div>
  <div class="admin-image-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="producto-image-modal-title">
    <header class="admin-image-modal-header">
      <div>
        <h2 class="admin-image-modal-title" id="producto-image-modal-title">Ajustar imagen</h2>
        <p class="admin-image-modal-subtitle">1200×800 px · arrastra para mover · optimizada para el catálogo</p>
      </div>
      <button type="button" class="admin-image-modal-close" id="producto-image-modal-close" aria-label="Cerrar editor">×</button>
    </header>

    <div class="admin-image-modal-body">
      <div class="admin-image-modal-preview">
        <p class="admin-image-editor-hint">Vista previa del recorte</p>
        <div class="admin-image-editor-stage" id="producto-image-stage">
          <canvas id="producto-image-canvas"></canvas>
        </div>
      </div>

      <div class="admin-image-modal-controls">
        <section class="admin-image-control-section">
          <h3 class="admin-image-control-title">Encuadre</h3>
          <div class="admin-image-editor-toolbar">
            <div class="admin-image-tool-row">
              <span class="admin-image-tool-label">Modo</span>
              <div class="admin-image-segmented" role="group" aria-label="Modo de encuadre">
                <button type="button" class="admin-image-segment is-active" data-fit="cover">Recortar</button>
                <button type="button" class="admin-image-segment" data-fit="contain">Encajar</button>
              </div>
            </div>
            <div class="admin-image-tool-row">
              <span class="admin-image-tool-label">Posición</span>
              <div class="admin-image-pos-grid" role="group" aria-label="Posición rápida">
                <button type="button" class="admin-image-pos-btn" data-pos="top-left" title="Arriba izquierda"></button>
                <button type="button" class="admin-image-pos-btn" data-pos="top" title="Arriba"></button>
                <button type="button" class="admin-image-pos-btn" data-pos="top-right" title="Arriba derecha"></button>
                <button type="button" class="admin-image-pos-btn" data-pos="left" title="Izquierda"></button>
                <button type="button" class="admin-image-pos-btn is-active" data-pos="center" title="Centro"></button>
                <button type="button" class="admin-image-pos-btn" data-pos="right" title="Derecha"></button>
                <button type="button" class="admin-image-pos-btn" data-pos="bottom-left" title="Abajo izquierda"></button>
                <button type="button" class="admin-image-pos-btn" data-pos="bottom" title="Abajo"></button>
                <button type="button" class="admin-image-pos-btn" data-pos="bottom-right" title="Abajo derecha"></button>
              </div>
            </div>
            <label class="admin-image-slider" for="producto-image-zoom">
              <span class="admin-image-slider-label">Zoom <strong id="producto-image-zoom-value">100%</strong></span>
              <input class="admin-image-range" type="range" id="producto-image-zoom" min="50" max="300" value="100" step="5">
            </label>
          </div>
        </section>

        <section class="admin-image-control-section">
          <h3 class="admin-image-control-title">Fondo del catálogo</h3>
          <div class="admin-image-editor-toolbar">
            <div class="admin-image-tool-row">
              <span class="admin-image-tool-label">Tipo</span>
              <div class="admin-image-segmented admin-image-segmented--wrap" role="group" aria-label="Fondo de la imagen exportada">
                <button type="button" class="admin-image-segment" data-bg="none">Sin fondo</button>
                <button type="button" class="admin-image-segment is-active" data-bg="white">Blanco</button>
                <button type="button" class="admin-image-segment" data-bg="cream">Crema</button>
                <button type="button" class="admin-image-segment" data-bg="gray">Gris</button>
                <button type="button" class="admin-image-segment" data-bg="gold">Dorado</button>
                <button type="button" class="admin-image-segment" data-bg="rose">Rosa</button>
                <button type="button" class="admin-image-segment" data-bg="sage">Salvia</button>
                <button type="button" class="admin-image-segment" data-bg="slate">Pizarra</button>
                <button type="button" class="admin-image-segment" data-bg="dark">Oscuro</button>
                <button type="button" class="admin-image-segment" data-bg="custom">Color</button>
              </div>
            </div>
            <div class="admin-image-tool-row admin-image-bg-custom" id="producto-image-bg-custom" hidden>
              <span class="admin-image-tool-label">Elegir</span>
              <input type="color" class="admin-image-bg-color" id="producto-image-bg-color" value="#ffffff" title="Color de fondo personalizado">
              <span class="admin-image-bg-color-hint">Se aplica al exportar 1200×800</span>
            </div>
          </div>
        </section>

        <section class="admin-image-control-section">
          <h3 class="admin-image-control-title">Orientación</h3>
          <div class="admin-image-editor-toolbar">
            <div class="admin-image-tool-row">
              <span class="admin-image-tool-label">Girar</span>
              <div class="admin-image-tool-btns">
                <button type="button" class="admin-image-tool-btn" id="producto-image-rotate-left" title="Girar 90° izquierda" aria-label="Girar 90 grados a la izquierda">↺</button>
                <button type="button" class="admin-image-tool-btn" id="producto-image-rotate-right" title="Girar 90° derecha" aria-label="Girar 90 grados a la derecha">↻</button>
              </div>
              <input class="admin-image-range admin-image-range--compact" type="range" id="producto-image-rotation" min="-180" max="180" value="0" step="1">
              <span class="admin-image-range-val" id="producto-image-rotation-value">0°</span>
            </div>
            <div class="admin-image-tool-row">
              <span class="admin-image-tool-label">Espejo</span>
              <div class="admin-image-tool-btns">
                <button type="button" class="admin-image-tool-btn" id="producto-image-flip-h" title="Espejo horizontal" aria-pressed="false">↔</button>
                <button type="button" class="admin-image-tool-btn" id="producto-image-flip-v" title="Espejo vertical" aria-pressed="false">↕</button>
              </div>
            </div>
          </div>
        </section>

        <section class="admin-image-control-section">
          <h3 class="admin-image-control-title">Luz y color</h3>
          <div class="admin-image-editor-sliders">
            <label class="admin-image-slider" for="producto-image-brightness">
              <span class="admin-image-slider-label">Brillo <strong id="producto-image-brightness-value">0</strong></span>
              <input class="admin-image-range" type="range" id="producto-image-brightness" min="-40" max="40" value="0" step="1">
            </label>
            <label class="admin-image-slider" for="producto-image-contrast">
              <span class="admin-image-slider-label">Contraste <strong id="producto-image-contrast-value">0</strong></span>
              <input class="admin-image-range" type="range" id="producto-image-contrast" min="-40" max="40" value="0" step="1">
            </label>
            <label class="admin-image-slider" for="producto-image-saturation">
              <span class="admin-image-slider-label">Saturación <strong id="producto-image-saturation-value">0</strong></span>
              <input class="admin-image-range" type="range" id="producto-image-saturation" min="-60" max="60" value="0" step="1">
            </label>
          </div>
        </section>
      </div>
    </div>

    <footer class="admin-image-modal-footer">
      <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" id="producto-image-remove-bg">Borrar fondo</button>
      <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" id="producto-image-ai-btn" title="Mejorar nitidez con Real-ESRGAN (~USD 0,0025/imagen)">Mejorar IA</button>
      <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" id="producto-image-reset">Restablecer todo</button>
      <div class="admin-image-modal-footer-actions">
        <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" id="producto-image-cancel">Cancelar</button>
        <button type="button" class="admin-btn admin-btn-primary admin-btn-sm" id="producto-image-apply">Aplicar cambios</button>
      </div>
    </footer>
  </div>
</div>

<script src="/js/admin-producto-image.js" defer></script>
