<%
  const pendientes = pedidos.filter((p) => p.estado === 'pendiente').length;
  const totalVentas = pedidos.reduce((s, p) => s + Number(p.total || 0), 0);
%>

<%- include('../../../partials/admin-page-header', {
  breadcrumbs: [{ label: 'Admin', href: '/admin/productos' }, { label: 'Ventas' }],
  pageHeading: 'Ventas',
  pageSubtitle: pedidos.length
    ? `${pedidos.length} pedido${pedidos.length === 1 ? '' : 's'} registrado${pedidos.length === 1 ? '' : 's'}`
    : 'Registra las ventas de la tienda',
  pageAction: { href: '/admin/pedidos/nuevo', label: 'Registrar venta' }
}) %>

<%- include('../../../partials/admin-flash') %>

<% if (pedidos.length) { %>
  <div class="admin-stats">
    <div class="admin-stat">
      <p class="admin-stat-value"><%= pedidos.length %></p>
      <p class="admin-stat-label">Pedidos</p>
    </div>
    <div class="admin-stat">
      <p class="admin-stat-value"><%= pendientes %></p>
      <p class="admin-stat-label">Pendientes</p>
    </div>
    <div class="admin-stat">
      <p class="admin-stat-value">$<%= totalVentas.toLocaleString('es-CO') %></p>
      <p class="admin-stat-label">Total vendido</p>
    </div>
  </div>
<% } %>

<% if (pedidos.length) { %>
<div class="admin-table-wrap">
  <div class="admin-table-toolbar">
    <span class="admin-table-count" data-filter-count hidden></span>
    <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-clear-filters hidden>Limpiar filtros</button>
  </div>
  <div class="admin-table-scroll">
    <table class="admin-table admin-table-filterable">
      <thead>
        <tr>
          <th>Pedido</th>
          <th>Cliente</th>
          <th>Dirección</th>
          <th>Productos</th>
          <th>Total</th>
          <th>Estado</th>
          <th>Fecha</th>
          <th class="col-actions">Acciones</th>
        </tr>
        <tr class="admin-table-filters">
          <th><input type="search" class="admin-table-filter" placeholder="Nº pedido..." aria-label="Filtrar pedido"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Cliente..." aria-label="Filtrar cliente"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Dirección..." aria-label="Filtrar dirección"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Cantidad..." aria-label="Filtrar productos"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Total..." aria-label="Filtrar total"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Estado..." aria-label="Filtrar estado"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Fecha..." aria-label="Filtrar fecha"></th>
          <th class="col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% pedidos.forEach((p) => {
          const fecha = new Date(p.created_at);
          const fechaStr = fecha.toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' });
          const editable = p.estado !== 'entregado';
        %>
          <tr>
            <td><span class="admin-product-code"><%= p.numero_pedido %></span></td>
            <td>
              <span class="admin-product-name"><%= p.cliente_nombre %> <%= p.cliente_apellido %></span>
            </td>
            <td><%= p.cliente_direccion %></td>
            <td><span class="admin-tag"><%= p.total_items %> producto<%= p.total_items === 1 ? '' : 's' %></span></td>
            <td><span class="admin-price">$<%= Number(p.total).toLocaleString('es-CO') %></span></td>
            <td>
              <% const estadoLabelRow = (pedidoEstados.find((e) => e.value === p.estado) || {}).label || p.estado; %>
              <button
                type="button"
                class="admin-badge admin-badge-pedido admin-badge-pedido--<%= p.estado %> admin-pedido-estado-trigger"
                data-pedido-id="<%= p.id %>"
                data-pedido-numero="<%= p.numero_pedido %>"
                data-estado="<%= p.estado %>"
                title="Cambiar estado"
                aria-haspopup="dialog"
              ><%= estadoLabelRow %></button>
            </td>
            <td><%= fechaStr %></td>
            <td class="admin-actions col-actions">
              <a href="/admin/pedidos/<%= p.id %>" class="admin-action-btn admin-action-btn-icon" title="Ver" aria-label="Ver">
                <%- include('../../../partials/admin-action-icon', { icon: 'view' }) %>
              </a>
              <% if (editable) { %>
                <a href="/admin/pedidos/<%= p.id %>/editar" class="admin-action-btn admin-action-btn-icon" title="Editar" aria-label="Editar">
                  <%- include('../../../partials/admin-action-icon', { icon: 'edit' }) %>
                </a>
              <% } %>
              <% if (editable) { %>
                <form action="/admin/pedidos/<%= p.id %>/eliminar" method="POST" class="auth-inline-form" onsubmit="return confirm('¿Eliminar este pedido?');">
                  <%- include('../../../partials/csrf-field') %>
                  <button type="submit" class="admin-action-btn admin-action-btn-icon admin-action-btn-danger" title="Eliminar" aria-label="Eliminar">
                    <%- include('../../../partials/admin-action-icon', { icon: 'delete' }) %>
                  </button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } else { %>
<div class="admin-table-wrap">
  <div class="admin-table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Pedido</th>
          <th>Cliente</th>
          <th>Total</th>
          <th>Estado</th>
          <th class="col-actions">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <tr class="admin-empty-row">
          <td colspan="5">
            <%- include('../../../partials/admin-empty', {
              title: 'Sin ventas registradas',
              description: 'Registra tu primera venta con los productos y datos del cliente.',
              action: { href: '/admin/pedidos/nuevo', label: 'Registrar venta' }
            }) %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
<% } %>
<%- include('../../../partials/admin-pedido-estado-modal', { pedidoEstados }) %>

