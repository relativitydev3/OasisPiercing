<%
  const activas = categorias.filter((c) => c.activo).length;
%>

<%- include('../../../partials/admin-page-header', {
  breadcrumbs: [{ label: 'Admin', href: '/admin/productos' }, { label: 'Categorías' }],
  pageHeading: 'Categorías',
  pageSubtitle: categorias.length
    ? `${categorias.length} categoría${categorias.length === 1 ? '' : 's'} · ${activas} activa${activas === 1 ? '' : 's'}`
    : 'Organiza tu catálogo por grupos',
  pageAction: { href: '/admin/categorias/nuevo', label: 'Nueva categoría' }
}) %>

<%- include('../../../partials/admin-flash') %>

<% if (categorias.length) { %>
  <div class="admin-stats">
    <div class="admin-stat">
      <p class="admin-stat-value"><%= categorias.length %></p>
      <p class="admin-stat-label">Total</p>
    </div>
    <div class="admin-stat">
      <p class="admin-stat-value"><%= activas %></p>
      <p class="admin-stat-label">Activas</p>
    </div>
    <div class="admin-stat">
      <p class="admin-stat-value"><%= categorias.reduce((s, c) => s + Number(c.total_productos || 0), 0) %></p>
      <p class="admin-stat-label">Productos</p>
    </div>
  </div>
<% } %>

<% if (categorias.length) { %>
<div class="admin-table-wrap">
  <div class="admin-table-toolbar">
    <span class="admin-table-count" data-filter-count hidden></span>
    <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-clear-filters hidden>Limpiar filtros</button>
  </div>
  <div class="admin-table-scroll">
    <table class="admin-table admin-table-filterable">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Productos</th>
          <th>Estado</th>
          <th class="col-actions">Acciones</th>
        </tr>
        <tr class="admin-table-filters">
          <th><input type="search" class="admin-table-filter" placeholder="Nombre..." aria-label="Filtrar nombre"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Descripción..." aria-label="Filtrar descripción"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Cantidad..." aria-label="Filtrar productos"></th>
          <th><input type="search" class="admin-table-filter" placeholder="Estado..." aria-label="Filtrar estado"></th>
          <th class="col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% categorias.forEach((c) => { %>
          <tr>
            <td><span class="admin-product-name"><%= c.nombre %></span></td>
            <td><%= c.descripcion || '—' %></td>
            <td><span class="admin-tag"><%= c.total_productos %> producto<%= c.total_productos === 1 ? '' : 's' %></span></td>
            <td>
              <%- include('../../../partials/admin-status', { activo: c.activo }) %>
            </td>
            <td class="admin-actions col-actions">
              <a href="/admin/categorias/<%= c.id %>/editar" class="admin-action-btn">Editar</a>
              <form action="/admin/categorias/<%= c.id %>/estado" method="POST" class="auth-inline-form">
                <%- include('../../../partials/csrf-field') %>
                <input type="hidden" name="activo" value="<%= c.activo ? 'false' : 'true' %>">
                <button type="submit" class="admin-action-btn"><%= c.activo ? 'Desactivar' : 'Activar' %></button>
              </form>
              <form action="/admin/categorias/<%= c.id %>/eliminar" method="POST" class="auth-inline-form" onsubmit="return confirm('¿Eliminar esta categoría?');">
                <%- include('../../../partials/csrf-field') %>
                <button type="submit" class="admin-action-btn admin-action-btn-danger">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } else { %>
<div class="admin-table-wrap">
  <div class="admin-table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Productos</th>
          <th>Estado</th>
          <th class="col-actions">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <tr class="admin-empty-row">
          <td colspan="5">
            <%- include('../../../partials/admin-empty', {
              title: 'Sin categorías',
              description: 'Las categorías agrupan los productos en la tienda.',
              action: { href: '/admin/categorias/nuevo', label: 'Crear categoría' }
            }) %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
<% } %>
