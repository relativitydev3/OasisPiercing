<%- include('../../partials/head', { title }) %>
<%- include('../../partials/nav-auth') %>

<main class="auth-main">
  <div class="auth-card">
    <h1 class="auth-title">Crear cuenta</h1>
    <% if (typeof fromCheckout !== 'undefined' && fromCheckout) { %>
      <p class="auth-sub auth-sub-highlight">Regístrate para completar tu pedido. Al crear la cuenta volverás a la tienda con tu carrito intacto.</p>
    <% } else { %>
      <p class="auth-sub">Regístrate como cliente en Oasis Piercing</p>
    <% } %>

    <%- include('../../partials/flash') %>

    <form action="/registro" method="POST" class="auth-form" novalidate>
      <%- include('../../partials/csrf-field') %>
      <div class="auth-grid-2">
        <div class="auth-field">
          <label for="nombre">Nombre *</label>
          <input type="text" id="nombre" name="nombre" value="<%= old.nombre || '' %>" required>
          <% if (errors.nombre) { %><span class="auth-error"><%= errors.nombre %></span><% } %>
        </div>
        <div class="auth-field">
          <label for="apellido">Apellido</label>
          <input type="text" id="apellido" name="apellido" value="<%= old.apellido || '' %>">
          <% if (errors.apellido) { %><span class="auth-error"><%= errors.apellido %></span><% } %>
        </div>
      </div>

      <div class="auth-field">
        <label for="email">Email *</label>
        <input type="email" id="email" name="email" value="<%= old.email || '' %>" autocomplete="email" required>
        <% if (errors.email) { %><span class="auth-error"><%= errors.email %></span><% } %>
      </div>

      <div class="auth-field">
        <label for="telefono">Teléfono *</label>
        <input type="tel" id="telefono" name="telefono" value="<%= old.telefono || '' %>" autocomplete="tel" required maxlength="10" inputmode="numeric" pattern="[0-9]{10}" title="Solo números, 10 dígitos" placeholder="Ej. 3001234567">
        <% if (errors.telefono) { %><span class="auth-error"><%= errors.telefono %></span><% } %>
      </div>

      <div class="auth-field">
        <label for="cc">Cédula (CC) *</label>
        <input type="text" id="cc" name="cc" value="<%= old.cc || '' %>" inputmode="numeric" autocomplete="off" required maxlength="10" pattern="[0-9]{10}" title="Solo números, 10 dígitos" placeholder="Ej. 1234567890" aria-describedby="cc-hint">
        <span class="auth-field-hint" id="cc-hint">Solo números, exactamente 10 dígitos.</span>
        <% if (errors.cc) { %><span class="auth-error"><%= errors.cc %></span><% } %>
      </div>

      <div class="auth-field">
        <label for="direccion">Dirección *</label>
        <textarea id="direccion" name="direccion" rows="3" required placeholder="Calle, número, barrio, ciudad, referencias..."><%= old.direccion || '' %></textarea>
        <% if (errors.direccion) { %><span class="auth-error"><%= errors.direccion %></span><% } %>
      </div>

      <div class="auth-field">
        <label for="password">Contraseña *</label>
        <input type="password" id="password" name="password" autocomplete="new-password" required>
        <% if (errors.password) { %><span class="auth-error"><%= errors.password %></span><% } %>
      </div>

      <div class="auth-field">
        <label for="confirmar_password">Confirmar contraseña *</label>
        <input type="password" id="confirmar_password" name="confirmar_password" autocomplete="new-password" required>
        <% if (errors.confirmar_password) { %><span class="auth-error"><%= errors.confirmar_password %></span><% } %>
      </div>

      <button type="submit" class="auth-btn">Crear cuenta</button>
    </form>

    <p class="auth-switch">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
  </div>
</main>

<%- include('../../partials/script-src', { src: '/js/auth-register.js', defer: true }) %>
<%- include('../../partials/footer-auth') %>
