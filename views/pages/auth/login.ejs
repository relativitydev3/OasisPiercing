<%- include('../../partials/head', { title }) %>
<%- include('../../partials/nav-auth') %>

<main class="auth-main">
  <div class="auth-card">
    <h1 class="auth-title">Iniciar sesión</h1>
    <p class="auth-sub">Accede a tu cuenta de Oasis Piercing</p>

    <%- include('../../partials/flash') %>

    <form action="/login" method="POST" class="auth-form" novalidate>
      <%- include('../../partials/csrf-field') %>
      <div class="auth-field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= old.email || '' %>" autocomplete="email" required>
        <% if (errors.email) { %><span class="auth-error"><%= errors.email %></span><% } %>
      </div>

      <div class="auth-field">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
        <% if (errors.password) { %><span class="auth-error"><%= errors.password %></span><% } %>
      </div>

      <button type="submit" class="auth-btn">Entrar</button>
    </form>

    <p class="auth-switch">¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
  </div>
</main>

<%- include('../../partials/footer-auth') %>
